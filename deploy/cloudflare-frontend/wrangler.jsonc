// Plain-Wrangler config for the docsign Worker (DEPLOYMENT.md §7). Deploy from a
// directory holding this file, redirect.js and the built app in ./build.
{
  "name": "docsign",
  "compatibility_date": "2026-10-06",
  "main": "./redirect.js",
  "assets": {
    "directory": "./build",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // redirect.js has to see every request to 301 the old name.
    "run_worker_first": true
  },
  "workers_dev": false,
  "routes": [
    { "pattern": "docsign.betterid.net", "custom_domain": true },
    { "pattern": "docsign.bettersign.ing", "custom_domain": true }
  ]
}
